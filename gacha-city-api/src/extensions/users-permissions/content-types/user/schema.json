{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "minLength": 6
    },
    "provider": {
      "type": "string"
    },
    "password": {
      "type": "password",
      "minLength": 6
    },
    "resetPasswordToken": {
      "type": "string"
    },
    "confirmationToken": {
      "type": "string"
    },
    "confirmed": {
      "type": "boolean",
      "default": false
    },
    "blocked": {
      "type": "boolean",
      "default": false
    },
    "characterName": {
      "type": "string"
    },
    "discordName": {
      "type": "string"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role"
    },
    "login_histories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::login-history.login-history",
      "mappedBy": "user"
    },
    "discordUser": {
      "type": "string"
    }
  }
}
